{
  "name": "@lizarzaburu/strapi-plugin-hls-video",
  "version": "0.0.0",
  "description": "Strapi plugin that converts uploaded videos to HLS (adaptive streaming) with ffmpeg, first-party and asynchronous",
  "keywords": [
    "strapi",
    "strapi-plugin",
    "strapi-5",
    "video",
    "hls",
    "ffmpeg",
    "streaming"
  ],
  "author": "Dennis Lizarzaburu <mail@dennislizarzaburu.de>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lizarzaburu/strapi-plugin-hls-video.git"
  },
  "bugs": {
    "url": "https://github.com/lizarzaburu/strapi-plugin-hls-video/issues"
  },
  "homepage": "https://github.com/lizarzaburu/strapi-plugin-hls-video#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "types": "./dist/server/src/index.d.ts",
      "source": "./server/src/index.ts",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ts:front": "tsc -p admin/tsconfig.json --noEmit",
    "test:ts:back": "tsc -p server/tsconfig.json --noEmit",
    "typecheck": "pnpm test:ts:back && pnpm test:ts:front"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "@strapi/design-system": "^2.2.4",
    "@strapi/icons": "^2.2.4",
    "@strapi/sdk-plugin": "^6.1.1",
    "@strapi/strapi": "^5.50.1",
    "@strapi/types": "^5.52.3",
    "@strapi/typescript-utils": "^5.50.1",
    "@types/ffprobe-static": "^2.0.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "prettier": "^3.9.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^6.8.9",
    "react-router-dom": "^6.30.6",
    "styled-components": "^6.5.3",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "@strapi/design-system": "^2.2.4",
    "@strapi/icons": "^2.2.4",
    "@strapi/sdk-plugin": "^6.1.1",
    "@strapi/strapi": "^5.50.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^6.8.9",
    "react-router-dom": "^6.30.6",
    "styled-components": "^6.5.3"
  },
  "engines": {
    "node": ">=20.0.0 <=22.x.x"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "ffmpeg-static",
      "ffprobe-static"
    ]
  },
  "strapi": {
    "kind": "plugin",
    "name": "hls-video",
    "displayName": "HLS Video",
    "description": "Converts uploaded videos to HLS (adaptive streaming) inside Strapi"
  }
}
